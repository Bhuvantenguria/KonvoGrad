{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "firebase/app": ["./node_modules/@firebase/app/dist/app-public.d.ts"],
      "firebase/firestore": ["./node_modules/@firebase/firestore/dist/firestore/src/api.d.ts"],
      "firebase/auth": ["./node_modules/@firebase/auth/dist/auth-public.d.ts"],
      "firebase/messaging": ["./node_modules/@firebase/messaging/dist/index-public.d.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
